{
  "version": 1,
  "skip_dirs": [
    ".git",
    "build",
    "_deps",
    "out"
  ],
  "skip_prefixes": [
    "build-",
    "build_",
    "cmake-build"
  ],
  "skip_globs": [],
  "encoding": [
    {
      "glob": "*.c",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cc",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cxx",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.h",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hh",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hxx",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "CMakeLists.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.cmake",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yaml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.sh",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/pre-commit",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/commit-msg",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE_1_0.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "NOTICE",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [
      "*.c",
      "*.cc",
      "*.cpp",
      "*.cxx",
      "*.h",
      "*.hh",
      "*.hpp",
      "*.hxx"
    ],
    "limit": 140,
    "tab_width": 4
  },
  "forbidden": [
    {
      "id": "cmake-libs",
      "globs": [
        "*.c",
        "*.cc",
        "*.cpp",
        "*.cxx",
        "*.h",
        "*.hh",
        "*.hpp",
        "*.hxx"
      ],
      "pattern": "#\\s*pragma\\s+comment\\s*\\(\\s*(lib|linker)",
      "message": "link Windows libraries through CMake target_link_libraries"
    }
  ],
  "versions": [],
  "required_files": [
    "LICENSE_1_0.txt",
    "README.md",
    "NOTICE"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.zh-CN.md",
        "README.ja.md",
        "README.ko.md"
      ],
      "switch_line": true,
      "stale": "warning"
    },
    "translations": {
      "pairs": [
        [
          "docs/zh/executor-and-tokens.md",
          "docs/en/executor-and-tokens.md"
        ]
      ],
      "marker": "translated-from:",
      "stale": "warning",
      "untracked": true
    }
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto eol=lf",
      "\\*\\.cpp\\s+-text -eol",
      "\\*\\.hpp\\s+-text -eol"
    ]
  },
  "comments": {
    "english": true
  },
  "commit_message": {
    "english": true
  },
  "readme_badges": {
    "files": [
      "README.md",
      "README.zh-CN.md",
      "README.ja.md",
      "README.ko.md"
    ],
    "min": 4,
    "require": [
      "actions/workflows/",
      "img.shields.io/badge/License"
    ]
  },
  "about": {
    "description": "A small, readable subset of Asio for study | 用于阅读和理解 asio 的极简实现",
    "order": "en-zh"
  },
  "actions": {
    "require": {
      "actions/checkout": "v7"
    },
    "allow_sha": true
  }
}
